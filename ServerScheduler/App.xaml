<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="ServerScheduler.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#CCFFFFFF" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="CalendarCellBorderBrush" Color="#10000000" />
                    <SolidColorBrush x:Key="CalendarCellHoverBrush" Color="#08000000" />
                    <SolidColorBrush x:Key="CalendarCellSelectedBrush" Color="#180A67FF" />
                    <SolidColorBrush x:Key="ScheduleCardBrush" Color="#08000000" />
                    <SolidColorBrush x:Key="TimelineTrackBrush" Color="#0B000000" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#0A67FF" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#140A67FF" />
                    <SolidColorBrush x:Key="BackgroundModeBrush" Color="#007A78" />
                    <SolidColorBrush x:Key="BackgroundModeSoftBrush" Color="#14007A78" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1B1B1B" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#616161" />
                    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#8A8A8A" />
                    <SolidColorBrush x:Key="OutsideMonthBrush" Color="#A6A6A6" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#C4202020" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="CalendarCellBorderBrush" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="CalendarCellHoverBrush" Color="#0CFFFFFF" />
                    <SolidColorBrush x:Key="CalendarCellSelectedBrush" Color="#306F8FFF" />
                    <SolidColorBrush x:Key="ScheduleCardBrush" Color="#0CFFFFFF" />
                    <SolidColorBrush x:Key="TimelineTrackBrush" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#79A8FF" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2879A8FF" />
                    <SolidColorBrush x:Key="BackgroundModeBrush" Color="#63C5C2" />
                    <SolidColorBrush x:Key="BackgroundModeSoftBrush" Color="#2863C5C2" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#C5C5C5" />
                    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#949494" />
                    <SolidColorBrush x:Key="OutsideMonthBrush" Color="#686868" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
            </Style>
            <Style x:Key="SubtleButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="MinWidth" Value="34" />
                <Setter Property="MinHeight" Value="34" />
            </Style>
            <Style x:Key="CalendarCellStyle" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{ThemeResource CalendarCellBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Margin" Value="3" />
                <Setter Property="Padding" Value="8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
