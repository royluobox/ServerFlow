<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ServerScheduler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="48" Padding="18,0,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <Border Width="26" Height="26" CornerRadius="7" Background="{ThemeResource AccentBrush}">
                    <FontIcon Glyph="&#xE8BF;" FontSize="15" Foreground="White" />
                </Border>
                <TextBlock Text="ServerFlow" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                <Border Width="1" Height="15" Background="{ThemeResource CardBorderBrush}" Margin="2,0" />
                <TextBlock Text="服务器排班" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24,8,24,16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button x:Name="PreviousMonthButton" Style="{StaticResource SubtleButtonStyle}" Click="PreviousMonth_Click" AutomationProperties.Name="上个月">
                                <FontIcon Glyph="&#xE76B;" FontSize="14" />
                            </Button>
                            <TextBlock x:Name="MonthTitle" Style="{StaticResource SectionTitleStyle}" Width="178" TextAlignment="Center" VerticalAlignment="Center" />
                            <Button x:Name="NextMonthButton" Style="{StaticResource SubtleButtonStyle}" Click="NextMonth_Click" AutomationProperties.Name="下个月">
                                <FontIcon Glyph="&#xE76C;" FontSize="14" />
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Border Width="8" Height="8" CornerRadius="2" Background="{ThemeResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="前台" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Border Width="8" Height="8" CornerRadius="2" Background="{ThemeResource BackgroundModeBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="后台" FontSize="11" Foreground="{ThemeResource SecondaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="单击日期查看或添加占用" FontSize="11" Foreground="{ThemeResource TertiaryTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="回到今天" Click="Today_Click" CornerRadius="6" Padding="14,7" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="3,0,3,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                            <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="周一" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Grid.Column="1" Text="周二" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Grid.Column="2" Text="周三" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Grid.Column="3" Text="周四" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Grid.Column="4" Text="周五" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Grid.Column="5" Text="周六" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Grid.Column="6" Text="周日" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    </Grid>
                    <Grid x:Name="CalendarGrid" Grid.Row="2" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="20">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4" Margin="0,0,0,18">
                        <TextBlock x:Name="SelectedDateTitle" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="SelectedDateSubtitle" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="13" />
                    </StackPanel>
                    <Button Grid.Row="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="AddSchedule_Click" Style="{StaticResource AccentButtonStyle}" CornerRadius="7" Padding="12,10" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                            <TextBlock Text="添加排班" />
                        </StackPanel>
                    </Button>
                    <Border Grid.Row="2" Height="1" Background="{ThemeResource CardBorderBrush}" Margin="0,0,0,14" />

                    <Grid Grid.Row="3">
                        <ListView x:Name="ScheduleList" SelectionMode="None" Background="Transparent" BorderThickness="0" Padding="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource ScheduleCardBrush}" CornerRadius="8" Padding="12">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="7">
                                                <TextBlock Text="{Binding TimeRange}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryTextBrush}" />
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Border Background="{Binding ModeBackground}" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding ModeText}" Foreground="{Binding ModeForeground}" FontSize="11" />
                                                    </Border>
                                                    <TextBlock Text="{Binding RecurrenceText}" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding DetailText}" Visibility="{Binding DetailVisibility}" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="11.5" TextWrapping="WrapWholeWords" />
                                                <TextBlock Text="{Binding Note}" Visibility="{Binding NoteVisibility}" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12" TextWrapping="WrapWholeWords" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Top" Tag="{Binding Id}" Click="DeleteSchedule_Click" AutomationProperties.Name="删除排班">
                                                <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="{ThemeResource SecondaryTextBrush}" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Margin="0,0,0,40">
                            <FontIcon Glyph="&#xE8BF;" FontSize="36" Foreground="{ThemeResource TertiaryTextBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="这一天还没有排班" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="14" HorizontalAlignment="Center" />
                            <TextBlock Text="服务器空闲，可以添加占用" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="12" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="DaySummary" Grid.Row="4" Margin="0,14,0,0" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12" HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Height="36" Padding="24,0" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <FontIcon x:Name="NetworkIcon" Glyph="&#xE774;" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" />
                    <TextBlock x:Name="NetworkStatus" Text="正在校准网络时间…" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" />
                    <HyperlinkButton Content="重新校准" Click="SyncTime_Click" Padding="4,0" Margin="4,0,0,0" FontSize="12" />
                    <Border Width="1" Height="12" Background="{ThemeResource CardBorderBrush}" Margin="8,0" />
                    <FontIcon Glyph="&#xE895;" FontSize="12" Foreground="{ThemeResource SecondaryTextBrush}" />
                    <TextBlock x:Name="UpdateStatus" Text="更新：待检查" Foreground="{ThemeResource SecondaryTextBrush}" FontSize="12" VerticalAlignment="Center" />
                    <HyperlinkButton Content="检查更新" Click="CheckUpdate_Click" Padding="4,0" Margin="4,0,0,0" FontSize="12" />
                </StackPanel>
                <TextBlock Text="排班仅保存到本机 · 无需账号" Foreground="{ThemeResource TertiaryTextBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
