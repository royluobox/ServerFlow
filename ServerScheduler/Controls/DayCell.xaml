<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ServerScheduler.Controls.DayCell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="RootBorder" Style="{StaticResource CalendarCellStyle}" Tapped="RootBorder_Tapped" PointerEntered="RootBorder_PointerEntered" PointerExited="RootBorder_PointerExited">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Height="26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="TodayBadge" Width="25" Height="25" CornerRadius="12.5" Background="{ThemeResource AccentBrush}" Visibility="Collapsed">
                    <TextBlock x:Name="TodayNumber" TextAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="12" FontWeight="SemiBold" />
                </Border>
                <TextBlock x:Name="DayNumber" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,0,0" />
                <TextBlock x:Name="MonthLabel" Grid.Column="1" FontSize="10" Foreground="{ThemeResource TertiaryTextBrush}" VerticalAlignment="Center" Margin="6,0,0,0" />
                <TextBlock x:Name="HoursLabel" Grid.Column="2" FontSize="10" Foreground="{ThemeResource SecondaryTextBrush}" VerticalAlignment="Center" />
            </Grid>
            <StackPanel x:Name="ItemsPanel" Grid.Row="1" Spacing="3" Margin="0,5,0,0" VerticalAlignment="Top" />
        </Grid>
    </Border>
</UserControl>
